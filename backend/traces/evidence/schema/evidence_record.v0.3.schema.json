{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "traces-evidence/0.3/evidence_record.schema.json",
 "title": "Traces evidence claim record",
 "description": "Version 3, 2026-10-21 (Decision 002-B). See EVIDENCE_SCHEMA.md and DECISIONS.md. One record per claim; exact duplicates consolidated with every contributing row kept. Append-only. class records claim origin only; status and label record verification.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "claim_id",
  "run_id",
  "repo",
  "repo_sha",
  "claim_kind",
  "granularity",
  "statement",
  "class",
  "originator",
  "provenance_raw",
  "provenance",
  "origin",
  "injected",
  "evidence_scope",
  "locations",
  "checks",
  "status",
  "label",
  "status_history",
  "visible_to_reviewer"
 ],
 "properties": {
  "schema_version": {
   "const": "traces-evidence/0.3"
  },
  "claim_id": {
   "type": "string",
   "pattern": "^c_[0-9a-f]{64}$",
   "description": "c_ + sha256 of canonical JSON of the claim identity (Decision 002-B ruling 2): relationship identity, normalized source location, unresolved target name, extractor identity"
  },
  "run_id": {
   "type": "string",
   "minLength": 1
  },
  "repo": {
   "type": "string",
   "minLength": 1
  },
  "repo_sha": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}$"
  },
  "claim_kind": {
   "enum": [
    "node",
    "relationship",
    "unresolved_reference"
   ]
  },
  "node_kind": {
   "type": "string"
  },
  "relationship_kind": {
   "enum": [
    "contains",
    "imports",
    "calls",
    "renders",
    "references",
    "instantiates",
    "extends",
    "navigates",
    "binds_handler",
    "implements_operation",
    "routes_to",
    "depends_on",
    "model_validation",
    "session_stage",
    "session_commit",
    "session_reload",
    "persistence_path",
    "uses_crud",
    "uses_model",
    "returns_model",
    "library_contract"
   ]
  },
  "granularity": {
   "enum": [
    "file",
    "symbol",
    "handler",
    "statement",
    "path"
   ]
  },
  "from": {
   "$ref": "#/$defs/endpoint"
  },
  "to": {
   "$ref": "#/$defs/endpoint"
  },
  "statement": {
   "type": "string",
   "minLength": 1
  },
  "class": {
   "enum": [
    "source_backed_declaration",
    "statically_derived",
    "analyzer_inference",
    "runtime_observed"
   ],
   "description": "Origin classification only (how the claim was produced). Independent of status and label; validation never changes it (Decision 002-B ruling 5)."
  },
  "originator": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "version",
    "role"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "role": {
     "enum": [
      "extractor",
      "external",
      "fixture"
     ]
    }
   }
  },
  "provenance_raw": {
   "type": "object"
  },
  "provenance": {
   "type": "string",
   "pattern": "^(codegraph:(structural|declaration|unresolved|resolved-import|resolved-qualified|resolved-instance|resolved-function-ref|resolved-framework|resolved-file-path|name-match|fuzzy|value-ref|tree-sitter|scip|synthesized:[a-z0-9-]+)|external:[a-z0-9-]+|fixture:(expected-chain|negative-control))$"
  },
  "origin": {
   "type": "object",
   "required": [
    "kind"
   ],
   "properties": {
    "kind": {
     "enum": [
      "tool_output",
      "external_document",
      "fixture"
     ]
    },
    "artifact": {
     "type": "string"
    },
    "row_ref": {
     "type": "string"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "quote": {
     "type": "string"
    },
    "fixture_id": {
     "type": "string"
    },
    "fixture_file": {
     "type": "string"
    },
    "derived_from": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "injected": {
   "type": "boolean"
  },
  "evidence_scope": {
   "const": "static"
  },
  "qualifier": {
   "type": [
    "string",
    "null"
   ]
  },
  "locations": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/location"
   }
  },
  "checks": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/check"
   }
  },
  "status": {
   "enum": [
    "observed",
    "verified",
    "unvalidated",
    "missing_location",
    "rejected"
   ]
  },
  "label": {
   "enum": [
    "observed",
    "verified",
    "inferred"
   ]
  },
  "status_reason": {
   "type": "string"
  },
  "status_history": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "from",
     "to",
     "at",
     "run_id",
     "check_ids",
     "by"
    ],
    "properties": {
     "from": {
      "enum": [
       null,
       "observed",
       "verified",
       "unvalidated",
       "missing_location",
       "rejected"
      ]
     },
     "to": {
      "enum": [
       "observed",
       "verified",
       "unvalidated",
       "missing_location",
       "rejected"
      ]
     },
     "at": {
      "type": "string",
      "format": "date-time"
     },
     "run_id": {
      "type": "string"
     },
     "check_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "by": {
      "type": "string"
     }
    }
   }
  },
  "supersedes": {
   "type": [
    "string",
    "null"
   ]
  },
  "visible_to_reviewer": {
   "const": true
  },
  "flags": {
   "type": "array",
   "items": {
    "enum": [
     "generated_file",
     "conditional_route",
     "runtime_config_dependent",
     "extractor_location_is_body",
     "extractor_file_errors",
     "library_contract"
    ]
   }
  },
  "consolidation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "rule",
    "count",
    "members"
   ],
   "properties": {
    "rule": {
     "type": "string",
     "minLength": 1
    },
    "count": {
     "type": "integer",
     "minimum": 2
    },
    "members": {
     "type": "array",
     "minItems": 2,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "row_ref",
       "provenance_raw",
       "status_history"
      ],
      "properties": {
       "row_ref": {
        "type": "string"
       },
       "provenance_raw": {
        "type": "object"
       },
       "status_history": {
        "type": "array",
        "minItems": 1
       }
      }
     }
    }
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "status": {
      "const": "verified"
     }
    },
    "required": [
     "status"
    ]
   },
   "then": {
    "properties": {
     "label": {
      "const": "verified"
     },
     "claim_kind": {
      "const": "relationship"
     },
     "injected": {
      "const": false
     },
     "locations": {
      "minItems": 1
     },
     "checks": {
      "contains": {
       "type": "object",
       "required": [
        "independent",
        "result",
        "method",
        "establishes"
       ],
       "properties": {
        "independent": {
         "const": true
        },
        "result": {
         "const": "pass"
        },
        "establishes": {
         "const": "relationship"
        },
        "method": {
         "enum": [
          "syntax_structure",
          "binding_resolution",
          "deterministic_rule"
         ]
        }
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "const": "observed"
     }
    },
    "required": [
     "status"
    ]
   },
   "then": {
    "properties": {
     "label": {
      "const": "observed"
     },
     "claim_kind": {
      "enum": [
       "node",
       "unresolved_reference",
       "relationship"
      ]
     },
     "locations": {
      "minItems": 1
     },
     "checks": {
      "contains": {
       "type": "object",
       "required": [
        "independent",
        "result",
        "method"
       ],
       "properties": {
        "independent": {
         "const": true
        },
        "result": {
         "const": "pass"
        },
        "method": {
         "const": "parser_presence"
        }
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "const": "observed"
     },
     "claim_kind": {
      "const": "relationship"
     }
    },
    "required": [
     "status",
     "claim_kind"
    ]
   },
   "then": {
    "required": [
     "qualifier"
    ],
    "properties": {
     "relationship_kind": {
      "const": "imports"
     },
     "qualifier": {
      "const": "observed import statement"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "enum": [
       "unvalidated",
       "missing_location",
       "rejected"
      ]
     }
    },
    "required": [
     "status"
    ]
   },
   "then": {
    "required": [
     "status_reason"
    ],
    "properties": {
     "label": {
      "const": "inferred"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "not": {
       "const": "missing_location"
      }
     }
    },
    "required": [
     "status"
    ]
   },
   "then": {
    "properties": {
     "locations": {
      "minItems": 1
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "relationship_kind": {
      "const": "persistence_path"
     }
    },
    "required": [
     "relationship_kind"
    ]
   },
   "then": {
    "required": [
     "qualifier"
    ],
    "properties": {
     "qualifier": {
      "const": "statically established persistence path"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "relationship_kind": {
      "const": "library_contract"
     }
    },
    "required": [
     "relationship_kind"
    ]
   },
   "then": {
    "properties": {
     "status": {
      "not": {
       "const": "verified"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "injected": {
      "const": true
     }
    },
    "required": [
     "injected"
    ]
   },
   "then": {
    "properties": {
     "class": {
      "const": "analyzer_inference"
     },
     "origin": {
      "properties": {
       "kind": {
        "enum": [
         "external_document",
         "fixture"
        ]
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "claim_kind": {
      "const": "relationship"
     }
    },
    "required": [
     "claim_kind"
    ]
   },
   "then": {
    "required": [
     "relationship_kind",
     "from",
     "to"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "claim_kind": {
      "const": "unresolved_reference"
     }
    },
    "required": [
     "claim_kind"
    ]
   },
   "then": {
    "required": [
     "from"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "claim_kind": {
      "const": "node"
     }
    },
    "required": [
     "claim_kind"
    ]
   },
   "then": {
    "required": [
     "node_kind"
    ]
   }
  }
 ],
 "$defs": {
  "endpoint": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "symbol",
    "file"
   ],
   "properties": {
    "symbol": {
     "type": "string",
     "pattern": "^[^:]+::.+$"
    },
    "file": {
     "type": "string"
    },
    "start_line": {
     "type": "integer",
     "minimum": 1
    },
    "end_line": {
     "type": "integer",
     "minimum": 0
    },
    "original_end_line": {
     "type": "integer",
     "minimum": 0,
     "description": "Extractor end line before EOF normalization (file endpoints only)"
    }
   }
  },
  "location": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "file",
    "start_line",
    "end_line",
    "line_base",
    "col_base",
    "range_kind",
    "range_rule",
    "role",
    "blob_sha",
    "source"
   ],
   "properties": {
    "file": {
     "type": "string",
     "pattern": "^(?!/)(?!\\.\\./)(?!.*/\\.\\./).*[^/]$"
    },
    "start_line": {
     "type": "integer",
     "minimum": 1
    },
    "end_line": {
     "type": "integer",
     "minimum": 0,
     "description": "Inclusive last addressable line. 0 only for a whole-file range of an empty blob."
    },
    "start_col": {
     "type": "integer",
     "minimum": 0
    },
    "end_col": {
     "type": "integer",
     "minimum": 0
    },
    "line_base": {
     "const": 1
    },
    "col_base": {
     "const": 0
    },
    "range_kind": {
     "enum": [
      "declaration",
      "body",
      "site",
      "enclosing_scope",
      "file"
     ]
    },
    "range_rule": {
     "enum": [
      "decorator_to_body_end",
      "header_to_body_end",
      "binding_statement",
      "body_only",
      "expression",
      "file"
     ]
    },
    "role": {
     "enum": [
      "site",
      "from_decl",
      "to_decl",
      "input"
     ]
    },
    "blob_sha": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    },
    "source": {
     "enum": [
      "originator",
      "validator"
     ]
    },
    "recovered_by": {
     "type": [
      "string",
      "null"
     ]
    },
    "original": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "start_line",
      "end_line"
     ],
     "properties": {
      "start_line": {
       "type": "integer",
       "minimum": 0
      },
      "end_line": {
       "type": "integer",
       "minimum": 0
      }
     },
     "description": "Originator coordinates before normalization (whole-file ranges)"
    },
    "end_exclusive_line": {
     "type": "integer",
     "minimum": 1,
     "description": "Exclusive end boundary = end_line + 1; may be the EOF position after a final newline, which is never an addressable line"
    },
    "terminal_newline": {
     "type": [
      "boolean",
      "null"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "range_kind": {
        "const": "file"
       }
      },
      "required": [
       "range_kind"
      ]
     },
     "then": {
      "required": [
       "original",
       "end_exclusive_line",
       "terminal_newline"
      ],
      "properties": {
       "start_line": {
        "const": 1
       }
      }
     },
     "else": {
      "properties": {
       "end_line": {
        "minimum": 1
       }
      },
      "not": {
       "anyOf": [
        {
         "required": [
          "original"
         ]
        },
        {
         "required": [
          "end_exclusive_line"
         ]
        },
        {
         "required": [
          "terminal_newline"
         ]
        }
       ]
      }
     }
    }
   ]
  },
  "check": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "check_id",
    "method",
    "establishes",
    "validator",
    "reads_originator_output",
    "independent",
    "inputs",
    "result",
    "detail",
    "run_id",
    "at"
   ],
   "properties": {
    "check_id": {
     "type": "string",
     "pattern": "^k_[0-9a-f]{64}$"
    },
    "method": {
     "enum": [
      "L1_path_exists",
      "L2_range_in_file",
      "L3_token_at_location",
      "parser_presence",
      "syntax_structure",
      "binding_resolution",
      "deterministic_rule",
      "location_recovery",
      "human_review"
     ]
    },
    "establishes": {
     "enum": [
      "presence",
      "location",
      "relationship",
      "none"
     ]
    },
    "rule_id": {
     "enum": [
      null,
      "R1",
      "R2",
      "R3",
      "R4",
      "R-contains",
      "R-valueRef",
      "R-enclosing"
     ]
    },
    "validator": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "version",
      "family"
     ],
     "properties": {
      "name": {
       "type": "string"
      },
      "version": {
       "type": "string"
      },
      "family": {
       "enum": [
        "cpython-ast",
        "typescript-compiler",
        "git",
        "text",
        "human"
       ]
      }
     }
    },
    "reads_originator_output": {
     "type": "boolean"
    },
    "independent": {
     "type": "boolean"
    },
    "inputs": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/location"
     }
    },
    "expected": {
     "type": "string"
    },
    "result": {
     "enum": [
      "pass",
      "fail",
      "inconclusive",
      "error"
     ]
    },
    "detail": {
     "type": "string",
     "minLength": 1
    },
    "run_id": {
     "type": "string"
    },
    "at": {
     "type": "string",
     "format": "date-time"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "independent": {
        "const": true
       }
      }
     },
     "then": {
      "properties": {
       "validator": {
        "properties": {
         "family": {
          "enum": [
           "cpython-ast",
           "typescript-compiler"
          ]
         }
        }
       },
       "reads_originator_output": {
        "const": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "method": {
        "enum": [
         "syntax_structure",
         "binding_resolution",
         "deterministic_rule"
        ]
       }
      }
     },
     "then": {
      "properties": {
       "validator": {
        "properties": {
         "family": {
          "enum": [
           "cpython-ast",
           "typescript-compiler"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "method": {
        "const": "parser_presence"
       }
      }
     },
     "then": {
      "properties": {
       "establishes": {
        "const": "presence"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "method": {
        "enum": [
         "L1_path_exists",
         "L2_range_in_file",
         "L3_token_at_location",
         "location_recovery"
        ]
       }
      }
     },
     "then": {
      "properties": {
       "establishes": {
        "const": "location"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "method": {
        "const": "human_review"
       }
      }
     },
     "then": {
      "properties": {
       "establishes": {
        "const": "none"
       },
       "independent": {
        "const": false
       }
      }
     }
    }
   ]
  }
 }
}
