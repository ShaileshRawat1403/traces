{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "traces-evidence/0.1/evidence_record.schema.json",
  "title": "Traces evidence claim record",
  "description": "Draft 1, 2026-10-21. See EVIDENCE_SCHEMA.md. One record per claim. Append-only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "run_id", "repo", "repo_sha", "claim_kind", "granularity", "statement", "class", "extractor", "provenance_raw", "provenance", "origin", "locations", "checks", "status", "status_history", "visible_to_reviewer"],
  "properties": {
    "schema_version": {"const": "traces-evidence/0.1"},
    "claim_id": {"type": "string", "pattern": "^c_[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "repo_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "claim_kind": {"enum": ["node", "relationship", "unresolved_reference"]},
    "node_kind": {"type": "string"},
    "relationship_kind": {"enum": ["contains", "imports", "calls", "references", "instantiates", "extends", "navigates", "renders", "binds_handler", "implements_operation", "routes_to", "depends_on", "persists_via", "uses_crud", "declares_model", "returns_model"]},
    "granularity": {"enum": ["file", "symbol", "handler", "statement"]},
    "from": {"$ref": "#/$defs/endpoint"},
    "to": {"$ref": "#/$defs/endpoint"},
    "statement": {"type": "string", "minLength": 1},
    "class": {"enum": ["source_backed_declaration", "statically_derived", "unverified_inference", "runtime_observed"]},
    "extractor": {"$ref": "#/$defs/tool"},
    "provenance_raw": {"type": "object"},
    "provenance": {"type": "string", "pattern": "^(codegraph:(structural|declaration|unresolved|resolved-import|resolved-qualified|resolved-instance|resolved-function-ref|resolved-framework|resolved-file-path|name-match|fuzzy|value-ref|tree-sitter|scip|synthesized:[a-z0-9-]+)|traces:(parser|rule:R[1-3])|external:[a-z0-9-]+|fixture:negative-control)$"},
    "origin": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["tool_output", "external_document", "negative_control"]},
        "artifact": {"type": "string"},
        "row_ref": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "quote": {"type": "string"},
        "fixture_id": {"type": "string"},
        "derived_from": {"type": "array", "items": {"type": "string"}}
      }
    },
    "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "status": {"enum": ["verified", "unvalidated", "missing_location", "rejected"]},
    "status_reason": {"type": "string"},
    "status_history": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "at", "run_id", "check_ids", "by"],
        "properties": {
          "from": {"enum": [null, "verified", "unvalidated", "missing_location", "rejected"]},
          "to": {"enum": ["verified", "unvalidated", "missing_location", "rejected"]},
          "at": {"type": "string", "format": "date-time"},
          "run_id": {"type": "string"},
          "check_ids": {"type": "array", "items": {"type": "string"}},
          "by": {"type": "string"}
        }
      }
    },
    "supersedes": {"type": ["string", "null"]},
    "visible_to_reviewer": {"const": true},
    "flags": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "verified"}}},
     "then": {"properties": {"class": {"not": {"const": "unverified_inference"}}, "locations": {"minItems": 1},
       "checks": {"contains": {"type": "object", "required": ["independent", "result", "method"],
         "properties": {"independent": {"const": true}, "result": {"const": "pass"}, "method": {"enum": ["parser_independent", "framework_rule"]}}}}}}},
    {"if": {"properties": {"status": {"not": {"const": "verified"}}}}, "then": {"required": ["status_reason"]}},
    {"if": {"properties": {"status": {"not": {"const": "missing_location"}}}}, "then": {"properties": {"locations": {"minItems": 1}}}},
    {"if": {"properties": {"claim_kind": {"const": "relationship"}}}, "then": {"required": ["relationship_kind", "from", "to"]}},
    {"if": {"properties": {"claim_kind": {"const": "unresolved_reference"}}}, "then": {"required": ["from"]}},
    {"if": {"properties": {"claim_kind": {"const": "node"}}}, "then": {"required": ["node_kind"]}}
  ],
  "$defs": {
    "endpoint": {
      "type": "object", "additionalProperties": false, "required": ["symbol", "file"],
      "properties": {
        "symbol": {"type": "string", "pattern": "^[^:]+::.+$"},
        "file": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "families"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "families": {"type": "array", "items": {"enum": ["codegraph-tree-sitter", "cpython-ast", "typescript-compiler", "second-parser", "none"]}}
      }
    },
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "start_line", "end_line", "line_base", "col_base", "precision", "range_rule", "role", "blob_sha"],
      "properties": {
        "file": {"type": "string", "pattern": "^[^/].*[^/]$"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "start_col": {"type": "integer", "minimum": 0},
        "end_col": {"type": "integer", "minimum": 0},
        "line_base": {"const": 1},
        "col_base": {"const": 0},
        "precision": {"enum": ["site", "declaration", "enclosing_scope", "file"]},
        "range_rule": {"enum": ["expression", "decorator_to_body_end", "def_to_body_end", "declaration_line", "file"]},
        "role": {"enum": ["site", "from_decl", "to_decl", "input"]},
        "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "recovered_by": {"type": ["string", "null"]}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "method", "validator", "reads_extractor_output", "independent", "inputs", "result", "detail", "run_id", "at"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^k_[0-9a-f]{64}$"},
        "method": {"enum": ["L1_path_exists", "L2_range_in_file", "L3_token_at_location", "parser_independent", "framework_rule", "location_recovery", "human_review"]},
        "validator": {"$ref": "#/$defs/tool"},
        "reads_extractor_output": {"type": "boolean"},
        "independent": {"type": "boolean"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/location"}},
        "expected": {"type": "string"},
        "result": {"enum": ["pass", "fail", "inconclusive", "error"]},
        "detail": {"type": "string", "minLength": 1},
        "run_id": {"type": "string"},
        "at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
